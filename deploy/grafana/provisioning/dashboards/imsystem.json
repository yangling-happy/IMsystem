{
  "uid": "imsystem-overview",
  "title": "IMSystem 运行概览",
  "tags": ["imsystem"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "在线连接数",
      "datasource": {
        "type": "prometheus",
        "uid": "imsystem-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "im_online_users",
          "legendFormat": "在线连接数"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "消息 QPS（受理 vs 落库）",
      "datasource": {
        "type": "prometheus",
        "uid": "imsystem-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(im_messages_total[1m]))",
          "legendFormat": "受理 QPS"
        },
        {
          "refId": "B",
          "expr": "sum(rate(im_persisted_total[1m]))",
          "legendFormat": "落库 QPS"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "限流拦截与幂等去重",
      "datasource": {
        "type": "prometheus",
        "uid": "imsystem-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(im_rate_limited_total[1m]))",
          "legendFormat": "限流拦截 /s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(im_duplicate_total[1m]))",
          "legendFormat": "幂等去重 /s"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "落库耗时 P95",
      "datasource": {
        "type": "prometheus",
        "uid": "imsystem-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(im_persist_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
